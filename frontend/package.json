{
  "name": "camaleon-frontend",
  "version": "3.2.9",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:notices": "vitest run src/lib/notices",
    "test:defaults": "vitest run src/lib/prefs/transmutation-defaults.test.ts",
    "test:performance": "vitest run src/lib/prefs/performance-prefs.test.ts",
    "test:notices-prefs": "vitest run src/lib/prefs/notices-prefs.test.ts",
    "test:semantic-alpha": "node scripts/verify-needs-semantic-alpha.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:cf": "opennextjs-cloudflare build && node scripts/sync-wasm-assets.mjs",
    "preview:cf": "npm run build:wasm && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "npm run build:wasm && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@serwist/next": "^9.5.11",
    "fflate": "^0.8.3",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serwist": "^9.5.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.102.0"
  }
}
